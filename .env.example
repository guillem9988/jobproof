# ==============================================================================
# JobProof — Environment Configuration Template
# All keys can also be configured directly via the in-app Settings UI.
# ==============================================================================

# AI Provider API Keys (Configure at least one)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Preferred AI Provider: "gemini", "anthropic", or "openai"
LLM_PROVIDER=

# Optional custom model ID (leave blank to use the provider's recommended default)
# Defaults: gemini -> "gemini-3.8-flash", anthropic -> "claude-sonnet-5-5", openai -> "gpt-6-sol"
LLM_MODEL=

# GitHub Personal Access Token (Optional: allows importing private repositories)
GITHUB_TOKEN=

# Public demo: set to true to disable imports, settings and real AI (see README, "Public Deployment")
HOSTED_MODE=false
# With HOSTED_MODE: private per-visitor workspaces + visitors bring their own AI key
HOSTED_BYOK=false
# Optional limited trial on the server's own Gemini key (use a key from a project WITHOUT billing)
# TRIAL_DAILY_CALLS=100
# TRIAL_WORKSPACE_CALLS=40
# TRIAL_UNTIL=2026-12-31

# Application & Database Settings
DATABASE_URL=sqlite:///./jobproof.db
STATIC_DIR=

# Bounds & Limits
MAX_FILES=150
MAX_FILE_BYTES=100000
MAX_PROJECT_BYTES=5000000
MAX_REQUIREMENTS=15
MAX_CONTEXT_CHARS=60000
MAX_CALLS=17
MAX_TOKENS=4096
EXTERNAL_TIMEOUT=45
MAX_RETRIES=1
TASK_WORKERS=2
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
