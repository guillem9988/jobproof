# ==============================================================================
# JobProof — Environment Configuration Template
# All keys can also be configured directly via the in-app Settings UI.
# ==============================================================================

# AI Provider API Keys (Configure at least one)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Preferred AI Provider: "gemini", "anthropic", or "openai"
LLM_PROVIDER=

# Optional custom model ID (leave blank to use the provider's recommended default)
# Defaults: gemini -> "gemini-3.8-flash", anthropic -> "claude-sonnet-4-6", openai -> "gpt-6-sol"
LLM_MODEL=

# GitHub Personal Access Token (Optional: raises rate limit to 5000/hr & allows private repos)
GITHUB_TOKEN=

# Application & Database Settings
DATABASE_URL=sqlite:///./jobproof.db
STATIC_DIR=

# Bounds & Limits
MAX_FILES=150
MAX_FILE_BYTES=100000
MAX_PROJECT_BYTES=5000000
MAX_REQUIREMENTS=15
MAX_CONTEXT_CHARS=60000
MAX_CALLS=17
MAX_TOKENS=4096
EXTERNAL_TIMEOUT=45
MAX_RETRIES=1
TASK_WORKERS=2
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
